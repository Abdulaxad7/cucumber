// ERD for the Cucumber Studio-like BDD platform.
// Owner: pm proposes, backend-swe keeps the as-built part in sync with the JPA entities.
// Legend: blue headers = as-built (auth-service code), orange headers = proposed (approved design 2026-10-12, not yet implemented).
// View: paste into https://dbdiagram.io or open with a DBML plugin. See docs/erd/README.md.

Project cucumber {
  database_type: 'PostgreSQL'
  Note: '''
  **As-built at 2026-10-12** (branch staging, HEAD 32eee07 plus the uncommitted auth-service phase 1 work, Batches A–C, review point C; no file under model/ was modified, and the Hibernate DDL was checked against this file). backend-swe keeps this in sync.

  **Conventions (all services)**
  - Primary keys: `id uuid`. auth-service generates them in the application (`@GeneratedValue(strategy = AUTO)` on a UUID field).
  - Names: snake_case tables and columns. Hibernate default naming turns camelCase fields into snake_case, so `seatLimit` becomes `seat_limit`.
  - Timestamps: `created_at` on every table, and `updated_at` on every mutable table. Immutable rows (history, attachments) have only `created_at`. As-built auth-service uses `LocalDateTime`, which maps to `timestamp(6)` without a zone. Proposed tables use `timestamptz` in UTC, matching the planned move to Instant (auth-service phase 4).
  - Enums are stored as strings (`@Enumerated(EnumType.STRING)`) and modelled as DBML Enums. Values are UPPER_SNAKE_CASE like the Java constants. An API may present execution statuses in lower case (passed, failed, ...), which is a contract decision, not a storage one.
  - Each service owns its own database. **There are no cross-service foreign keys.** A column that points into another service is a plain uuid with a note "references <service>.<table>.id (by ID, no FK)".
  - Within one service, relations are real foreign keys (Ref).

  **Legend**
  - Table note starts with "as-built": the table exists today exactly as described.
  - Table note starts with "proposed — approved design (2026-10-12), not yet implemented": a domain design by pm, approved by the user on 2026-10-12 (ERD-D1..D11). Nothing is built yet.
  - "proposed (auth-service phase 1)" would mark an entity change planned by docs/specs/auth-service.md but not yet in code. **Phase 1 plans none**: its "Will not be touched" list includes every entity in model/. Phase 1 only changes the values written (lower-cased emails, plan FREE, seat_limit 5), and those are noted on the columns.

  **Runtime database today:** H2 in-memory, schema generated by Hibernate (`ddl-auto: create`). There are no migrations. PostgreSQL plus Flyway is auth-service phase 4. Type notes below say where H2 and PostgreSQL DDL differ.
  '''
}

// =====================================================================
// AS-BUILT: auth-service (com.example.authservice.model, enums)
// =====================================================================

Enum user_status {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION [note: 'set by register and by anonymous invitation acceptance. Phase 1 (D4): may log in; only SUSPENDED is blocked.']
}

Enum plan {
  FREE [note: 'set by createOrganization; the only plan written in phase 1']
  TEAM
  ENTERPRISE
}

Enum organization_role {
  OWNER [note: 'rank 4 (rank is Java-only via isAtLeast, not stored)']
  ADMIN [note: 'rank 3']
  MEMBER [note: 'rank 2']
  READER [note: 'rank 1']
}

Enum project_role {
  ADMIN
  MEMBER
  TESTER
  READER
}

Enum invitation_status {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED [note: 'never written by code today; expiry is computed from expires_at, so a stored PENDING may already be expired (spec glossary)']
}

Table users [headercolor: #2D6A9F] {
  id uuid [pk, not null]
  email varchar(255) [unique, not null, note: 'unique is case-sensitive in the DB. The application trims and lower-cases emails before storing and comparing them (D12), and the API limits them to 254 characters (E17).']
  password_hash varchar(255) [null, note: 'explicitly nullable (@Column(nullable = true)); BCrypt hash']
  full_name varchar(255) [null, note: 'no @Column: nullable, default length 255. The API limits it to 100 characters (E17).']
  status user_status [null, note: 'EnumType.STRING, nullable. H2 DDL: native enum(...); PostgreSQL DDL: varchar(255) plus a check constraint']
  mfa_enabled boolean [not null, note: 'primitive boolean, so Hibernate adds NOT NULL; no DB default']
  created_at timestamp(6) [null, note: 'set by application code, no @CreationTimestamp']
  updated_at timestamp(6) [null, note: 'set once at register; nothing updates it later']

  Note: 'as-built (entity User, @Table users)'
}

Table organizations [headercolor: #2D6A9F] {
  id uuid [pk, not null]
  name varchar(255) [null, note: 'no @Column: nullable, length 255 in the DB. The API limits it to 1-100 non-blank characters (E17); duplicates are allowed.']
  plan plan [null, note: 'EnumType.STRING, nullable']
  seat_limit int [null, note: 'Integer; null means unlimited (spec glossary). createOrganization sets app.orgs.free-seat-limit (default 5). Seats used = members + PENDING invitations not yet expired (D11).']
  created_at timestamp(6) [null]

  Note: 'as-built (entity Organization, @Table organizations). No updated_at column. Invitations, acceptances, role changes and removals lock this row (SELECT ... FOR UPDATE) so the seat limit and the last-owner rule hold under concurrent requests.'
}

Table org_memberships [headercolor: #2D6A9F] {
  id uuid [pk, not null]
  user_id uuid [not null]
  org_id uuid [not null]
  role organization_role [null, note: 'EnumType.STRING, nullable in the DB although every membership needs a role']
  created_at timestamp(6) [null]

  indexes {
    (user_id, org_id) [unique]
  }
  Note: 'as-built (entity OrgMembership). Exactly one role per user and organization. created_at is joinedAt in the member list. Rows are deleted when a member is removed or leaves.'
}

Table projects [headercolor: #2D6A9F] {
  id uuid [pk, not null]
  org_id uuid [not null]
  name varchar(255) [null, note: 'nullable, no uniqueness per organization']
  secret_token varchar(255) [null, note: 'stored in plain text, not unique, nullable. Purpose is not specified (probably a CI upload token).']
  created_at timestamp(6) [null]

  Note: 'as-built (entity Project). The entity has no getters, setters or constructors, so no code can read or write it yet. No project API exists (auth-service phase 2).'
}

Table project_memberships [headercolor: #2D6A9F] {
  id uuid [pk, not null]
  user_id uuid [not null]
  project_id uuid [not null]
  role project_role [null, note: 'EnumType.STRING, nullable']
  created_at timestamp(6) [null]

  indexes {
    (user_id, project_id) [unique]
  }
  Note: 'as-built (entity ProjectMembership). Unused in phase 1.'
}

Table invitations [headercolor: #2D6A9F] {
  id uuid [pk, not null]
  email varchar(255) [null, note: 'nullable, case-sensitive in the DB. The application trims and lower-cases it (D12).']
  org_id uuid [null, note: 'nullable: set for organization invitations']
  project_id uuid [null, note: 'nullable: set for project invitations. No DB check that exactly one of org_id and project_id is set.']
  role varchar(255) [null, note: 'free text, not an enum. Holds either an organization_role or a project_role name, so the DB cannot validate it.']
  invited_by uuid [not null]
  token varchar(255) [unique, null, note: 'unique but nullable; acceptance token (24 random bytes, 32 URL-safe characters), stored in plain text. Returned once, in the create-invitation response.']
  status invitation_status [null, note: 'EnumType.STRING, nullable. Written: PENDING on create, ACCEPTED on accept, REVOKED on revoke.']
  expires_at timestamp(6) [null, note: 'created_at + 7 days, set by the application']
  created_at timestamp(6) [null]

  Note: '''
  as-built (entity Invitation).
  "One pending, unexpired invitation per organization and email" (D11) is enforced only in the application, not by a DB constraint.
  Accepting locks the row (SELECT ... FOR UPDATE) before any user or membership is written, so a token is single use (Q5).
  '''
}

Table audit_log [headercolor: #2D6A9F] {
  id uuid [pk, not null]
  actor_id uuid [not null]
  action varchar(255) [null, note: 'free text, no enum of actions']
  org_id uuid [null]
  project_id uuid [null]
  target_user_id uuid [null]
  metadata json [null, note: 'String field with columnDefinition json. Risk: PostgreSQL rejects a varchar bound to a json column without a cast or @JdbcTypeCode(SqlTypes.JSON), and H2 stores it as a JSON string literal (double-encoded).']
  created_at timestamp(6) [null]

  Note: 'as-built (entity AuditLog, @Table audit_log, singular unlike the other tables). No accessors and no writer; audit writing is deferred to auth-service phase 2 (D8).'
}

Ref: org_memberships.user_id > users.id
Ref: org_memberships.org_id > organizations.id
Ref: projects.org_id > organizations.id
Ref: project_memberships.user_id > users.id
Ref: project_memberships.project_id > projects.id
Ref: invitations.org_id > organizations.id
Ref: invitations.project_id > projects.id
Ref: invitations.invited_by > users.id
Ref: audit_log.actor_id > users.id
Ref: audit_log.org_id > organizations.id
Ref: audit_log.project_id > projects.id
Ref: audit_log.target_user_id > users.id

TableGroup auth_service {
  users
  organizations
  org_memberships
  projects
  project_memberships
  invitations
  audit_log
}

// =====================================================================
// PROPOSED: scenario-service (Gherkin content)
// =====================================================================

Enum scenario_kind {
  BACKGROUND [note: 'proposed — approved design (2026-10-12), not yet implemented (whole enum). Background steps are not a test case on their own.']
  SCENARIO [note: 'Scenario or Example keyword']
  SCENARIO_OUTLINE [note: 'Scenario Outline or Scenario Template keyword; has examples']
}

Enum step_keyword {
  GIVEN [note: 'proposed — approved design (2026-10-12), not yet implemented (whole enum)']
  WHEN
  THEN
  AND
  BUT
  ASTERISK [note: 'the * bullet keyword']
}

Enum step_argument_type {
  NONE [note: 'proposed — approved design (2026-10-12), not yet implemented (whole enum)']
  DATA_TABLE
  DOC_STRING
}

Enum tag_target_type {
  FEATURE [note: 'proposed — approved design (2026-10-12), not yet implemented (whole enum)']
  RULE
  SCENARIO [note: 'also used for Scenario Outline']
  EXAMPLES
}

Table features [headercolor: #D9822B] {
  id uuid [pk, not null]
  project_id uuid [not null, note: 'references auth_service.projects.id (by ID, no FK)']
  path varchar(1024) [not null, note: 'path of the .feature file in the project, e.g. features/checkout/payment.feature. Replaces a folder table in the MVP.']
  name varchar(500) [not null, note: 'text after Feature: in the current version']
  description text [null]
  language varchar(10) [not null, default: 'en', note: 'from the Gherkin # language: header']
  current_version int [not null, note: 'feature_versions.version that the parsed tables (rules, scenarios, steps, examples) reflect']
  created_by uuid [not null, note: 'references auth_service.users.id (by ID, no FK)']
  updated_by uuid [null, note: 'references auth_service.users.id (by ID, no FK)']
  archived_at timestamptz [null, note: 'soft delete: results in report_service keep pointing at this id']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (project_id, path) [unique]
  }
  Note: '''
  proposed — approved design (2026-10-12), not yet implemented.
  One Gherkin file. The Gherkin text in feature_versions is the source of truth. The rules, scenarios, steps, examples and example_rows tables are a parse of the current version only, kept for search, tag filtering and linking results (ERD-D3, ERD-D4).
  Uniqueness of (project_id, path) should exclude archived rows (a partial unique index in PostgreSQL; DBML cannot express it).
  Living documentation = the current version of each non-archived feature plus the latest result per scenario. It is computed and needs no table in the MVP. Later: a doc_releases table (a named map of feature_id to version) for published snapshots.
  '''
}

Table feature_versions [headercolor: #D9822B] {
  id uuid [pk, not null]
  feature_id uuid [not null]
  version int [not null, note: 'starts at 1, +1 on every saved change']
  source text [not null, note: 'full Gherkin text of the file at this version']
  content_hash varchar(64) [not null, note: 'SHA-256 hex of source; saving identical content creates no new version']
  message varchar(500) [null, note: 'optional change message']
  created_by uuid [not null, note: 'references auth_service.users.id (by ID, no FK)']
  created_at timestamptz [not null]

  indexes {
    (feature_id, version) [unique]
  }
  Note: 'proposed — approved design (2026-10-12), not yet implemented. Immutable history of a feature. A diff between versions is computed from source, not stored. Later: import from Git (commit SHA per version) as a column.'
}

Table rules [headercolor: #D9822B] {
  id uuid [pk, not null]
  feature_id uuid [not null]
  keyword_text varchar(50) [not null, note: 'keyword as written, e.g. Rule (localised languages differ)']
  name varchar(500) [not null]
  description text [null]
  position int [not null, note: 'order among the children of the feature']
  line int [null, note: 'line number in the current version source']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'proposed — approved design (2026-10-12), not yet implemented. A Gherkin Rule (Gherkin 6+) that groups a Background and scenarios.'
}

Table scenarios [headercolor: #D9822B] {
  id uuid [pk, not null, note: 'stable across versions when the scenario is matched on re-parse (ERD-D3); results reference it']
  feature_id uuid [not null]
  rule_id uuid [null, note: 'set when the scenario or background sits inside a Rule']
  kind scenario_kind [not null]
  keyword_text varchar(50) [not null, note: 'keyword as written, e.g. Scenario, Example, Scenario Outline, Background']
  name varchar(1000) [null, note: 'a Background may have no name']
  description text [null]
  position int [not null, note: 'order within the feature or rule']
  line int [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: '''
  proposed — approved design (2026-10-12), not yet implemented.
  Holds Backgrounds, Scenarios and Scenario Outlines in one table so that steps have one parent. Rule enforced by the application: at most one BACKGROUND per feature and per rule.
  A **test case** is not stored: it is a SCENARIO, or one example row of a SCENARIO_OUTLINE (ERD-D5).
  '''
}

Table steps [headercolor: #D9822B] {
  id uuid [pk, not null]
  scenario_id uuid [not null]
  position int [not null]
  keyword step_keyword [not null]
  keyword_text varchar(50) [not null, note: 'keyword as written, e.g. Given, Soit (localised)']
  step_text text [not null, note: 'step text without the keyword; may contain <placeholders> in outlines']
  argument_type step_argument_type [not null, default: 'NONE']
  data_table json [null, note: 'when DATA_TABLE: array of rows, each an array of cell strings']
  doc_string text [null, note: 'when DOC_STRING: content between the delimiters']
  doc_string_media_type varchar(100) [null, note: 'optional media type after the opening delimiter, e.g. json']
  line int [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'proposed — approved design (2026-10-12), not yet implemented. A step has at most one argument: a data table or a doc string (ERD-D6). Later: a step definition library for autocomplete, kept in a table note until needed.'
}

Table examples [headercolor: #D9822B] {
  id uuid [pk, not null]
  scenario_id uuid [not null, note: 'must be a SCENARIO_OUTLINE (application rule)']
  keyword_text varchar(50) [not null, note: 'Examples or Scenarios, as written']
  name varchar(500) [null]
  description text [null]
  position int [not null]
  header json [not null, note: 'array of column names, e.g. ["user","result"]']
  line int [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'proposed — approved design (2026-10-12), not yet implemented. One Examples block of a Scenario Outline. Can carry its own tags.'
}

Table example_rows [headercolor: #D9822B] {
  id uuid [pk, not null, note: 'referenced by results; one row = one test case']
  examples_id uuid [not null]
  position int [not null]
  cells json [not null, note: 'array of cell strings, same length as examples.header']
  line int [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'proposed — approved design (2026-10-12), not yet implemented. Kept as rows, not JSON inside examples, because each row is a test case that results point to.'
}

Table tags [headercolor: #D9822B] {
  id uuid [pk, not null]
  project_id uuid [not null, note: 'references auth_service.projects.id (by ID, no FK)']
  name varchar(255) [not null, note: 'with the leading @, e.g. @smoke; compared case-sensitively like Cucumber tag expressions']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (project_id, name) [unique]
  }
  Note: 'proposed — approved design (2026-10-12), not yet implemented. Project-wide tag catalogue for filtering and autocomplete. Tags are written in the Gherkin text; this table is derived on parse (ERD-D7).'
}

Table tag_assignments [headercolor: #D9822B] {
  id uuid [pk, not null]
  tag_id uuid [not null]
  target_type tag_target_type [not null]
  target_id uuid [not null, note: 'id in features, rules, scenarios or examples depending on target_type. Polymorphic, so no FK; the parser keeps it consistent.']
  created_at timestamptz [not null]

  indexes {
    (tag_id, target_type, target_id) [unique]
    (target_type, target_id)
  }
  Note: 'proposed — approved design (2026-10-12), not yet implemented. Which element carries which tag. Inherited tags (feature to scenario) are computed, not stored.'
}

Ref: feature_versions.feature_id > features.id [delete: cascade]
Ref: rules.feature_id > features.id [delete: cascade]
Ref: scenarios.feature_id > features.id [delete: cascade]
Ref: scenarios.rule_id > rules.id [delete: cascade]
Ref: steps.scenario_id > scenarios.id [delete: cascade]
Ref: examples.scenario_id > scenarios.id [delete: cascade]
Ref: example_rows.examples_id > examples.id [delete: cascade]
Ref: tag_assignments.tag_id > tags.id [delete: cascade]

TableGroup scenario_service {
  features
  feature_versions
  rules
  scenarios
  steps
  examples
  example_rows
  tags
  tag_assignments
}

// =====================================================================
// PROPOSED: report-service (test runs and results) -- owner is decision ERD-D2
// =====================================================================

Enum execution_status {
  PASSED [note: 'proposed — approved design (2026-10-12), not yet implemented (whole enum). Cucumber statuses, stored upper case.']
  FAILED
  SKIPPED
  PENDING
  UNDEFINED
  AMBIGUOUS
  UNKNOWN [note: 'not executed yet, e.g. a planned manual test case. Same name as the Cucumber messages status (ERD-D8).']
}

Enum test_run_source {
  MANUAL [note: 'proposed — approved design (2026-10-12), not yet implemented (whole enum). Testers record results by hand.']
  AUTOMATED [note: 'results uploaded from a Cucumber run, e.g. by CI']
}

Enum test_run_status {
  PLANNED [note: 'proposed — approved design (2026-10-12), not yet implemented (whole enum)']
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

Enum step_result_kind {
  STEP [note: 'proposed — approved design (2026-10-12), not yet implemented (whole enum)']
  BEFORE_HOOK
  AFTER_HOOK
}

Table environments [headercolor: #D9822B] {
  id uuid [pk, not null]
  project_id uuid [not null, note: 'references auth_service.projects.id (by ID, no FK)']
  name varchar(100) [not null, note: 'e.g. staging, production, Chrome 129']
  description text [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (project_id, name) [unique]
  }
  Note: 'proposed — approved design (2026-10-12), not yet implemented. Where a test run executed. Later: key/value attributes (browser, OS) as a json column.'
}

Table builds [headercolor: #D9822B] {
  id uuid [pk, not null]
  project_id uuid [not null, note: 'references auth_service.projects.id (by ID, no FK)']
  name varchar(255) [not null, note: 'build or version label, e.g. 1.4.2+517']
  branch varchar(255) [null]
  commit_sha varchar(64) [null]
  ci_url varchar(2048) [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (project_id, name) [unique]
  }
  Note: 'proposed — approved design (2026-10-12), not yet implemented. The software build under test. Several runs (environments) can share one build.'
}

Table test_runs [headercolor: #D9822B] {
  id uuid [pk, not null]
  project_id uuid [not null, note: 'references auth_service.projects.id (by ID, no FK)']
  name varchar(255) [not null]
  source test_run_source [not null]
  status test_run_status [not null, default: 'PLANNED']
  environment_id uuid [null]
  build_id uuid [null]
  tag_expression varchar(1000) [null, note: 'Cucumber tag expression that selected the scope, e.g. @smoke and not @wip']
  created_by uuid [null, note: 'references auth_service.users.id (by ID, no FK); null when uploaded with a project token']
  started_at timestamptz [null]
  finished_at timestamptz [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (project_id, created_at)
  }
  Note: '''
  proposed — approved design (2026-10-12), not yet implemented.
  One execution of a set of test cases. MANUAL runs are created with one test_case_results row per selected test case in status UNKNOWN; AUTOMATED runs are created from an uploaded result file.
  Reports (pass rate, trends, per tag) are computed from runs and results; no report table in the MVP. Later: denormalised status counters on this table if queries get slow, and saved report filters.
  '''
}

Table test_case_results [headercolor: #D9822B] {
  id uuid [pk, not null]
  test_run_id uuid [not null]
  position int [not null, note: 'order in the run']
  feature_id uuid [null, note: 'references scenario_service.features.id (by ID, no FK); null when an uploaded result matches no known feature']
  feature_version_id uuid [null, note: 'references scenario_service.feature_versions.id (by ID, no FK); the version that was executed, if known']
  scenario_id uuid [null, note: 'references scenario_service.scenarios.id (by ID, no FK)']
  example_row_id uuid [null, note: 'references scenario_service.example_rows.id (by ID, no FK); set for Scenario Outline test cases']
  feature_path varchar(1024) [not null, note: 'snapshot at run time, so history survives edits and deletions']
  scenario_name varchar(1000) [not null, note: 'snapshot; for outlines, the name with placeholders filled in']
  tags json [null, note: 'snapshot: array of tag names incl. inherited ones']
  status execution_status [not null, default: 'UNKNOWN', note: 'worst step status using the Cucumber precedence; set by hand for MANUAL runs']
  attempt int [not null, default: 1, note: 'retry number for automated reruns']
  executed_by uuid [null, note: 'references auth_service.users.id (by ID, no FK); the tester for MANUAL runs']
  comment text [null, note: 'tester remark for MANUAL runs']
  started_at timestamptz [null]
  finished_at timestamptz [null]
  duration_ms bigint [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (test_run_id, position)
    scenario_id
  }
  Note: 'proposed — approved design (2026-10-12), not yet implemented. The result of one test case (a scenario, or one example row of an outline) in one run.'
}

Table step_results [headercolor: #D9822B] {
  id uuid [pk, not null]
  test_case_result_id uuid [not null]
  position int [not null, note: 'order of execution, including background steps and hooks']
  kind step_result_kind [not null, default: 'STEP']
  step_id uuid [null, note: 'references scenario_service.steps.id (by ID, no FK); null for hooks or unmatched steps']
  keyword_text varchar(50) [null, note: 'snapshot']
  step_text text [null, note: 'snapshot with outline placeholders filled in; null for hooks']
  status execution_status [not null, default: 'UNKNOWN']
  duration_ms bigint [null]
  error_message text [null, note: 'failure message and stack trace as reported by Cucumber']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (test_case_result_id, position)
  }
  Note: 'proposed — approved design (2026-10-12), not yet implemented. Per-step status. Background steps appear here as ordinary steps of each test case, as in Cucumber output.'
}

Table attachments [headercolor: #D9822B] {
  id uuid [pk, not null]
  test_case_result_id uuid [not null]
  step_result_id uuid [null, note: 'set when attached to a step (screenshots, logs)']
  media_type varchar(255) [not null, note: 'e.g. image/png; logs use text/x.cucumber.log+plain']
  file_name varchar(255) [null]
  size_bytes bigint [not null]
  content bytea [not null, note: 'MVP: stored in the DB with a size cap (ERD-D9). Later: object storage with a storage_key column instead.']
  created_by uuid [null, note: 'references auth_service.users.id (by ID, no FK); null for automated uploads']
  created_at timestamptz [not null]

  indexes {
    test_case_result_id
  }
  Note: 'proposed — approved design (2026-10-12), not yet implemented. Screenshots, logs and other files attached to a test case or step result. Immutable.'
}

Ref: test_runs.environment_id > environments.id [delete: set null]
Ref: test_runs.build_id > builds.id [delete: set null]
Ref: test_case_results.test_run_id > test_runs.id [delete: cascade]
Ref: step_results.test_case_result_id > test_case_results.id [delete: cascade]
Ref: attachments.test_case_result_id > test_case_results.id [delete: cascade]
Ref: attachments.step_result_id > step_results.id [delete: cascade]

TableGroup report_service {
  environments
  builds
  test_runs
  test_case_results
  step_results
  attachments
}
