# Local development settings for the "dev" profile of auth-service and api-gateway.
# Copy this file to .env in the repository root and fill in the values. .env is gitignored: never commit it.
# Both services read this one file, so they share the same JWT secret.

# Shared HS512 signing secret: standard Base64 of at least 64 random bytes. Generate one with:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Password of the local development database (the cucumber-postgres container, see auth-service/README.md).
# Any value without "${". Generate one with:
#   openssl rand -hex 24
AUTH_DB_PASSWORD=
